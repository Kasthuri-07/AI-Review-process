# Application Settings
TIMEZONE=Asia/Kolkata
PASSING_SCORE_THRESHOLD=70
DEFAULT_REVIEW_INTERVAL_DAYS=3
OVERDUE_CHECK_HOURS=6

# GCR & Meeting Link
DEFAULT_MEETING_LINK=https://meet.google.com/zag-rcxj-kae
DEFAULT_GCR_LINK=https://meet.google.com/zag-rcxj-kae

# Email Transport Settings
# Mode: 'MOCK' (saves to local /outbox directory without sending) or 'SMTP' (live delivery)
EMAIL_MODE=MOCK
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=kasthuricute273@gmail.com
SMTP_PASSWORD=your_gmail_app_password_here
SMTP_USE_TLS=True
SENDER_NAME="Internship Operations Team"
SENDER_EMAIL=kasthuricute273@gmail.com
RECEIVER_EMAIL=kasthurikumar1105@gmail.com
EMAIL_MAX_RETRIES=3

# AI & LLM Provider Configuration
# Supported providers: 'MOCK' (local deterministic rubric audit), 'OPENAI', 'GEMINI', 'ANTHROPIC'
LLM_PROVIDER=MOCK

# OpenAI Settings (if using OPENAI)
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# Google Gemini Settings (if using GEMINI)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash

# Anthropic Claude Settings (if using ANTHROPIC)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Google Classroom OAuth (Optional - required only for direct classroom sync)
GOOGLE_APPLICATION_CREDENTIALS=credentials.json
